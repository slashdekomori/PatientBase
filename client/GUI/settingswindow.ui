   </rect>
  </property>
  <property name="windowTitle">
   <string>Настройки</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget {
	font-family: &quot;Noto Sans&quot;;
    background-color: rgb(35, 36, 39); /* Однотонный цвет фона */
    color: #d3d3d3; /* Светлый текст, но не белый */
}
QTabWidget {
    background-color: rgb(47, 48, 52);
    border: none; /* Убираем рамку */
    color: white; /* Белый текст для названий полей */
    padding: 10px;
}
QTableView {
    background-color: #2f3133; /* Цвет фона таблицы */
    color: #d3d3d3; /* Цвет текста */
    gridline-color: #444444; /* Цвет сетки */
}

/* Стиль для ячеек таблицы */
QTableView::item {
    background-color: #212224; /* Цвет фона ячеек */
    color: #d3d3d3; /* Цвет текста ячеек */
}

/* Стиль для выделенных ячеек */
QTableView::item:selected {
    background-color: #2baaff; /* Цвет фона выделенной ячейки */
    color: white; /* Цвет текста выделенной ячейки */
}

/* Стиль для заголовков таблицы */
QHeaderView {
    background-color: #333333; /* Цвет фона заголовков */
    color: white; /* Цвет текста заголовков */
    font-size: 18px; /* Размер шрифта заголовков */
    /*padding: 10px; /* Отступы для заголовков */
}

/* Стиль для заголовков столбцов */
QHeaderView::section {
    background-color: #333333; /* Цвет фона заголовков столбцов */
    color: white; /* Цвет текста заголовков столбцов */
   /* padding: 10px; /* Отступы для заголовков столбцов */
}

/* Стиль для заголовков строк */
QHeaderView::vertical {
    background-color: #333333; /* Цвет фона заголовков строк */
    color: white; /* Цвет текста заголовков строк */
}

/* Стиль для вкладок QTabWidget */
QTabBar::tab {
    background: rgb(35, 36, 39);
    color: #d3d3d3; /* Светлый текст */
    padding: 10px;
    border: none; /* Убираем рамку */
    font-size: 18px;
}

QTabBar::tab:selected { 
    color: white; /* Белый текст при выборе вкладки */ 
    border-bottom: 1px solid #2baaff;
} 

QTabBar::tab:hover {
    color: white; /* Белый текст при наведении */
}

QGroupBox {
    border: none; /* Без рамки */
    color: white; /* Белый текст для названий полей */
    padding: 10px;
}

/* Стиль для QLabel */
QLabel {
    color: white; /* Белый текст */
    background: none; /* Убираем градиент */
    font-size: 18px; /* Размер текста */
}

/* Общий стиль для всех полей ввода */
QComboBox, QLineEdit, QTextEdit, QDateTimeEdit, QDateEdit {
    background: rgb(47, 48, 52); /* Цвет заполнения без градиента */
    color: rgb(234, 235, 255); /* Светлый текст */
    border: none; /* Без рамок */
    border-radius: 3px; /* Скругленные углы */
    font-size: 16px; /* Размер текста */
}

/* Стиль для QCheckBox */
QCheckBox {
    color: rgb(190, 211, 214); /* Светлый текст */
    border: none; /* Без рамок */
    border-radius: 3px; /* Скругленные углы */
    font-size: 16px; /* Размер текста */
}

QCheckBox::indicator:checked {
	color: white; /* Белый текст */
    background: none; /* Убираем градиент */
    border: 2px solid #2baaff; /* Рамка для отмеченного индикатора */
}

/* Стиль для отключенных чекбоксов */
QCheckBox:disabled {
    color: #7f7f7f; /* Приглушенный цвет текста */
    opacity: 0.5; /* Уменьшенная непрозрачность для визуального эффекта */
}

/* Эффект фокуса для чекбоксов */


/* Нижняя рамка для полей ввода при фокусе */
QCheckBox:focus, QComboBox:focus, QLineEdit:focus, QTextEdit:focus, QDateTimeEdit:focus, QDateEdit:focus {
    border-bottom: 1px solid #2baaff; /* Цвет нижней рамки при фокусе */
}

QCheckBox:checked {
    border-bottom: 1px solid #2baaff; /* Рамка при отмеченном состоянии */
}

/* Стиль для QPushButton */
QPushButton {
    background-color: #333333; /* Цвет кнопки */
    color: rgb(190, 211, 214); /* Светлый текст */
    border: none; /* Без рамок */
    padding: 10px;
    border-radius: 5px;
    border-bottom: 1px solid #2baaff;
}

QPushButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1, stop: 0 #444444, stop: 1 #3b3b3b); /* Светлее при наведении */
}

QPushButton:pressed {
    border: 2px solid #2baaff; /* Рамка при нажатии */
}

/* Эффект фокуса для кнопок */
QPushButton:focus {
    outline: none; /* Убираем стандартный фокус */
    border: 2px solid #2baaff; /* Рамка при фокусе */
}</string>
